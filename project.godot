SaveSystem="*res://autoload/save_system.gd"
WorldStateSystem="*res://autoload/world_state_system.gd"
GameTimeSystem="*res://autoload/game_time_system.gd"
VehicleStateSystem="*res://autoload/vehicle_state_system.gd"
GameFlags="*res://autoload/game_flags.gd"
ConditionSystem="*res://autoload/condition_system.gd"

