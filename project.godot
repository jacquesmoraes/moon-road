config_version=5

[application]

config/name="TerraLua"
config/description="Road trip from Earth to the Moon — Godot 4 project scaffold"
run/main_scene="res://scenes/test/DrivingSandbox.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

JourneySystem="*res://autoload/journey_system.gd"

