enabled = true
on_choose_actions = [ExtResource("3_start"), ExtResource("4_rel")]

[sub_resource type="Resource" id="choice_refuse"]
script = ExtResource("2_choice")
id = "refuse_help"
text = "Agora não."
next_dialogue_id = ""
enabled = true

[resource]
script = ExtResource("1_script")
id = "mira_quest_offer_02"
speaker_name = "Mira"
text = "Me traz 3 Scrap Metal e 1 Copper Wire, depois liga o terminal. Topa?"
