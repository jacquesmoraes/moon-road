[gd_resource type="Resource" script_class="DialogueDefinition" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/dialogue/dialogue_definition.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/dialogue/dialogue_choice.gd" id="2_choice"]
[ext_resource type="Resource" path="res://resources/dialogue/actions/start_quest_power_viewpoint.tres" id="3_start"]
[ext_resource type="Resource" path="res://resources/dialogue/actions/add_relationship_mira_kind.tres" id="4_rel"]

[sub_resource type="Resource" id="choice_accept"]
script = ExtResource("2_choice")
id = "accept_help"
text = "Pode deixar — eu resolvo."
